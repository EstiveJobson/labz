<UserControl x:Class="Labz.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="32" MaxWidth="640" HorizontalAlignment="Left">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <Button Content="{Binding NewProjectLabel}" Command="{Binding NewCommand}" Margin="0,0,8,0" Padding="12,8" />
            <Button Content="{Binding OpenRef1Label}" Command="{Binding OpenRef1Command}" Margin="0,0,8,0" Padding="12,8" />
            <Button Content="{Binding OpenLabel}" Command="{Binding OpenCommand}" Margin="0,0,8,0" Padding="12,8" />
            <Button Content="{Binding SaveLabel}" Command="{Binding SaveCommand}" Margin="0,0,8,0" Padding="12,8" />
            <Button Content="{Binding SaveAsLabel}" Command="{Binding SaveAsCommand}" Padding="12,8" />
        </StackPanel>
        <Button Content="{Binding NewFromIdeaLabel}" IsEnabled="{Binding IdeaEnabled}" HorizontalAlignment="Left" Padding="12,8" />
        <TextBlock Text="{Binding IdeaHint}" Margin="0,8,0,24" Foreground="#52606D" />
        <TextBlock Text="{Binding RecentHeader}" FontSize="18" FontWeight="SemiBold" />
        <TextBlock Text="{Binding EmptyRecent}" Margin="0,8,0,0" Foreground="#52606D">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasRecent}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <ListBox ItemsSource="{Binding Recent}" Margin="0,8,0,0" BorderThickness="0">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Button Content="{Binding Name}"
                            Command="{Binding DataContext.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding Folder}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0,6" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </StackPanel>
</UserControl>
