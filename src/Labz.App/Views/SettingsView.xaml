<UserControl x:Class="Labz.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="32" MaxWidth="420" HorizontalAlignment="Left">
        <TextBlock Text="{Binding AutosaveLabel}" FontWeight="SemiBold" />
        <TextBox Text="{Binding AutosaveText, UpdateSourceTrigger=LostFocus}" Margin="0,6,0,0" Width="120" HorizontalAlignment="Left" />
        <TextBlock Text="{Binding AutosaveHint}" Margin="0,6,0,16" Foreground="#52606D" TextWrapping="Wrap" />
        <TextBlock Text="{Binding DigitsLabel}" FontWeight="SemiBold" />
        <TextBox Text="{Binding DigitsText, UpdateSourceTrigger=LostFocus}" Margin="0,6,0,0" Width="120" HorizontalAlignment="Left" />
        <TextBlock Text="{Binding Error}" Margin="0,12,0,0" Foreground="#B42318" TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
